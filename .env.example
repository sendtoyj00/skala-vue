# 이 파일은 커밋된다 — 실제 키 값은 절대 넣지 않는다.
# 로컬 개발 시 `cp .env.example .env.local` 후 아래 값을 각자 채운다.
# (vue_architecture.md 9.5 — 이미 커밋된 키는 .env로 옮겨도 안전해지지 않는다. git 이력에 남으므로 재발급이 필요하다.)

# OpenWeatherMap — https://home.openweathermap.org/api_keys
VITE_OWM_API_KEY=

# 기상청 도로기상관측자료 — https://apihub.kma.go.kr (data.go.kr 활용신청번호 15159045)
VITE_KMA_AUTH_KEY=

# Google Ad Placement(adBreak) — 발급받은 client id. 없으면 테스트용 placeholder 사용 가능
# (developers.google.com/ad-placement/docs/test)
VITE_ADSENSE_CLIENT_ID=

# 카카오맵 JavaScript 키 — https://developers.kakao.com/console/app
# 콘솔의 플랫폼 > Web에 서비스 도메인을 등록해야 브라우저에서 SDK가 로드된다.
VITE_KAKAO_APP_KEY=
